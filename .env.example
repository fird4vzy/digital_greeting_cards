# Absolute origin used in QR codes and share links. This is the only value that
# is correct on a card that has already been printed — set it in production.
NEXT_PUBLIC_SITE_URL=https://morethanabouquet.com

# PostgreSQL. Unset, the app uses a file-backed store and needs no setup —
# which on a read-only serverless filesystem means orders are kept in memory
# and lost, so any real deployment must set this.
#   psql "$DATABASE_URL" -f lib/db/schema.sql
# DATABASE_URL=postgres://user:pass@localhost:5432/bouquet

# Switches the card planner from the deterministic heuristic to Claude.
# ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the shop dashboard, entered at /admin/login.
# Required in production: unset, nobody can sign in at all.
# Changing it signs every existing session out.
# Local `npm run dev` does not need it.
# ADMIN_PASSWORD=

# Telegram notifications for new orders. Both required, or nothing is sent —
# which is what every preview deployment and `npm run dev` should do.
#   TELEGRAM_BOT_TOKEN  from @BotFather
#   TELEGRAM_CHAT_ID    the group or person to notify
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
