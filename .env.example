# Absolute origin used in QR codes and share links. This is the only value that
# is correct on a card that has already been printed — set it in production.
NEXT_PUBLIC_SITE_URL=https://birdunyo.uz

# PostgreSQL. Unset, the app uses a file-backed store and needs no setup —
# which on a read-only serverless filesystem means orders are kept in memory
# and lost, so any real deployment must set this.
#   psql "$DATABASE_URL" -f lib/db/schema.sql
# DATABASE_URL=postgres://user:pass@localhost:5432/bouquet

# Планировщик открытки на Claude. Нужны обе переменные: без AI_PLANNER=on
# один ключ ничего не включает — см. lib/ai/planner.ts. Без них работает
# детерминированная эвристика, и это рабочий режим, а не заглушка.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PLANNER=on

# Общий счётчик частоты запросов (вход в админку, создание заказов).
# Без них счёт идёт в памяти инстанса: на Vercel это значит «лимит × число
# инстансов», то есть защита слабее, но она есть.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Shared password for the shop dashboard, entered at /admin/login.
# Required in production: unset, nobody can sign in at all AND every session
# cookie is refused — до 28 августа второе было неправдой, и админка без
# пароля открывалась ключом из этого же репозитория.
# Changing it signs every existing session out.
# Local `npm run dev` does not need it.
# ADMIN_PASSWORD=

# Необязательно: отдельный ключ подписи сессий. Пока не задан, ключом служит
# ADMIN_PASSWORD — тогда каждая выданная кука годится для офлайнового подбора
# пароля. Задайте, если пароль короткий или живёт долго.
#   node -e "console.log(crypto.randomUUID())"
# ADMIN_SESSION_SECRET=

# Telegram notifications for new orders. Both required, or nothing is sent —
# which is what every preview deployment and `npm run dev` should do.
#   TELEGRAM_BOT_TOKEN  from @BotFather
#   TELEGRAM_CHAT_ID    the group or person to notify
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Секрет вебхука: Telegram шлёт его заголовком в каждом запросе, и без
# совпадения маршрут ничего не принимает. Без неё маршрут отвечает 404 —
# открытый вебхук позволил бы любому писать в рабочую группу.
#   node -e "console.log(crypto.randomUUID())"
#   npm run tg:webhook set https://ваш-домен
# TELEGRAM_WEBHOOK_SECRET=

# Темы в супергруппе-форуме. Необязательны: без них всё идёт в общий поток.
# Номер темы: правый щелчок по ней → «Копировать ссылку». Можно вставить
# ссылку целиком — берётся последнее число.
#   npm run tg:webhook topics   — проверит живой отправкой
# TELEGRAM_TOPIC_ORDERS=
# TELEGRAM_TOPIC_SUPPORT=
